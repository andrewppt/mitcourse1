# ---------------------------------------------------------------------------
# teams-recording-share — copy to .env and fill in. See docs/SETUP.md.
# The CLI, the MCP server and the webhook service all read this file.
# ---------------------------------------------------------------------------

# --- Entra (Azure AD) application -----------------------------------------

# Directory (tenant) ID of the Microsoft 365 tenant. Required.
TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the app registration. Required.
CLIENT_ID=00000000-0000-0000-0000-000000000000

# "delegated" = browser sign-in as a person (CLI / MCP on your laptop).
# "app"       = client credentials, no user (the unattended webhook service).
# Default: delegated
AUTH_MODE=delegated

# Client secret of the app registration. Required when AUTH_MODE=app, ignored otherwise.
# Keep it out of source control.
CLIENT_SECRET=

# Interactive sign-in flow for delegated mode.
#   browser     = authorization code + PKCE; opens a browser and listens on http://localhost:<port>
#                 (register http://localhost under "Mobile and desktop applications"). Default.
#   device-code = prints a code to enter at microsoft.com/devicelogin; only works if the tenant
#                 allows public client flows.
LOGIN_FLOW=browser

# Fixed loopback port for the browser sign-in redirect. 0 = pick a free port (Entra accepts any
# port for a registered http://localhost URI). Default: 0
LOGIN_REDIRECT_PORT=0

# Scopes requested during delegated sign-in (space or comma separated).
# Leave empty to use the defaults:
#   OnlineMeetings.Read OnlineMeetingRecording.Read.All OnlineMeetingArtifact.Read.All
#   Files.ReadWrite Calendars.Read Mail.Send User.Read offline_access
DELEGATED_SCOPES=

# Where the delegated token cache is written, mode 0600.
# Default: <STATE_DIR>/msal-cache.json
TOKEN_CACHE_PATH=

# --- Webhook service -------------------------------------------------------

# Organizer user object ids or UPNs whose meetings the service subscribes to
# (comma, semicolon or whitespace separated). Leave empty for one tenant-wide
# subscription on communications/onlineMeetings/getAllRecordings.
ORGANIZER_USER_IDS=

# Public HTTPS base URL Graph can reach, no trailing slash. Graph posts to
# <PUBLIC_BASE_URL>/webhook/notifications and /webhook/lifecycle.
# In development this is your ngrok URL.
PUBLIC_BASE_URL=

# Port the service listens on. Default: 3978
PORT=3978

# Shared secret echoed back by Graph in every notification. Notifications that
# do not carry exactly this value are dropped. Generate a random string.
CLIENT_STATE=

# Directory for on-disk state (subscription ids, processed recordings, errors,
# and by default the token cache). Default: ./data
STATE_DIR=./data

# --- Sharing behaviour -----------------------------------------------------

# Role granted on the recording file: read | write. Default: read
SHARE_ROLE=read

# Ask OneDrive to email each recipient its own sharing invitation. Default: true
SEND_INVITATION=true

# Message included in that invitation.
INVITATION_MESSAGE=Here is the recording of our meeting.

# What to do with people `invite` cannot add directly (typically brand-new
# external guests under app-only auth):
#   users-link     - create a scope:"users" sharing link and grant it to them (default)
#   anonymous-link - create an anonymous view link and email it to them (needs Mail.Send
#                    and a tenant policy that allows "anyone" links)
#   skip           - record them as skipped and do nothing
EXTERNAL_FALLBACK=users-link

# Hours until a fallback link expires. 0 = no expiry. Default: 0
FALLBACK_LINK_EXPIRY_HOURS=0

# Also grant access to people invited on the calendar event who never joined.
# Default: false
INCLUDE_CALENDAR_INVITEES=false

# Addresses that always get access, whether or not they attended
# (comma/whitespace separated). Example: an archive mailbox.
ALWAYS_INCLUDE=

# Email domains treated as internal, used to mark attendees internal/external
# (comma/whitespace separated). Empty = derive from the organizer's own domain.
INTERNAL_DOMAINS=

# --- Recording file lookup -------------------------------------------------

# OneDrive folder Teams drops recordings into. Localised tenants may differ.
# Default: Recordings
RECORDINGS_FOLDER=Recordings

# How long to keep retrying to find the recording file in OneDrive after the
# notification arrives (minutes). Default: 20
DRIVE_LOOKUP_TIMEOUT_MINUTES=20

# --- Misc ------------------------------------------------------------------

# Graph endpoint. Override only for national clouds or tests.
# Default: https://graph.microsoft.com
GRAPH_BASE_URL=https://graph.microsoft.com

# debug | info | warn | error. Logs are JSON lines on stderr. Default: info
LOG_LEVEL=info
